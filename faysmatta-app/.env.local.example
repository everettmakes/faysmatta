# Copy this file to .env.local and fill in your values

# --- Vercel Postgres (Neon) ---
# Get these from: Vercel Dashboard → Storage → your database → .env.local tab
DATABASE_URL="postgres://..."
DATABASE_URL_UNPOOLED="postgres://..."

# --- Admin panel ---
# Choose a memorable password for your mum!
ADMIN_PASSWORD="choose-a-good-password"

# --- Cloudinary (image uploads in admin) ---
# Find these at: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="dqnjc6i7b"
CLOUDINARY_UPLOAD_PRESET="your_unsigned_upload_preset"

# --- Resend (contact/request-to-buy emails) ---
RESEND_API_KEY="your_resend_api_key"
